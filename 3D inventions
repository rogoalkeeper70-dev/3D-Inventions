<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hama Beads & Impresión 3D</title>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
    }

    body {
      min-height: 100dvh; /* 🔥 solución real para móviles */
      display: flex;
      flex-direction: column;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #4c1d95, #fde047);
      color: white;
      padding-bottom: env(safe-area-inset-bottom);
    }

    header {
      text-align: center;
      padding: 25px 15px;
    }

    header h1 {
      margin: 0;
      font-size: clamp(1.8rem, 4vw, 3rem);
    }

    header p {
      margin-top: 8px;
      font-size: clamp(1rem, 2.5vw, 1.2rem);
      font-style: italic;
    }

    main {
      flex: 1; /* 🔥 empuja footer correctamente */
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    nav {
      display: grid;
      gap: 15px;
      width: 100%;
      max-width: 600px;
    }

    @media (min-width: 600px) {
      nav { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 900px) {
      nav { grid-template-columns: repeat(3, 1fr); }
    }

    .btn {
      padding: 15px;
      font-size: 1rem;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      font-weight: bold;
      transition: 0.3s;
      width: 100%;
    }

    .btn:nth-child(odd) {
      background: #fde047;
      color: #4c1d95;
    }

    .btn:nth-child(even) {
      background: #7c3aed;
      color: white;
    }

    .btn:hover {
      transform: scale(1.05);
      opacity: 0.9;
    }

    footer {
      text-align: center;
      padding: 10px;
      font-size: 0.8rem;
      background: rgba(0,0,0,0.25);
    }

    .whatsapp {
      position: fixed;
      bottom: 15px;
      right: 15px;
      background: #25D366;
      color: white;
      padding: 12px 16px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: bold;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
      transition: 0.3s;
      font-size: clamp(0.8rem, 2vw, 1rem);
    }

    .whatsapp:hover {
      transform: scale(1.1);
    }

  </style>
</head>
<body>

  <header>
    <h1>Hama Beads & Impresión 3D</h1>
    <p>Creating what you want</p>
  </header>

  <main>
    <nav>
      <button class="btn">Encargos</button>
      <button class="btn">Diseños</button>
      <button class="btn">Llaveros</button>
      <button class="btn">Figuras</button>
      <button class="btn">Lo más vendido</button>
    </nav>
  </main>

  <footer>
    © 2026 3D & Hama beads- Todos los derechos reservados
  </footer>

  <a class="whatsapp" href="https://wa.me/" target="_blank">WhatsApp</a>

</body>
</html>
