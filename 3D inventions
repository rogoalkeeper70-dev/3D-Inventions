<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>3D & Hama Studio</title>

  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #4c1d95, #fde047);
      color: white;
    }

    header {
      text-align: center;
      padding: 30px 15px;
    }

    header h1 {
      font-size: clamp(2rem, 5vw, 3rem);
    }

    header p {
      margin-top: 10px;
      font-style: italic;
    }

    main {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    /* 🔥 CAMBIO CLAVE: FLEX en vez de GRID */
    .menu {
      display: flex;
      flex-direction: column;
      gap: 15px;
      width: 100%;
      max-width: 400px;
    }

    .card {
      padding: 18px;
      border-radius: 14px;
      text-align: center;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(0,0,0,0.25);
    }

    .card:nth-child(odd) {
      background: #fde047;
      color: #4c1d95;
    }

    .card:nth-child(even) {
      background: #7c3aed;
      color: white;
    }

    footer {
      text-align: center;
      padding: 10px;
      font-size: 0.8rem;
      background: rgba(0,0,0,0.25);
    }

    .whatsapp {
      position: fixed;
      bottom: 15px;
      right: 15px;
      background: #25D366;
      color: white;
      padding: 12px 16px;
      border-radius: 50px;
      text-decoration: none;
      font-weight: bold;
    }

  </style>
</head>
<body>

  <header>
    <h1>3D & Hama Studio</h1>
    <p>Creating what you want</p>
  </header>

  <main>
    <div class="menu">
      <div class="card">Encargos</div>
      <div class="card">Diseños</div>
      <div class="card">Llaveros</div>
      <div class="card">Figuras</div>
      <div class="card">Lo más vendido</div>
    </div>
  </main>

  <footer>
    © 2026 3D & Hama Studio
  </footer>

  <a class="whatsapp" href="https://wa.link/s068zb" target="_blank">WhatsApp</a>

</body>
</html>
